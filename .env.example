# Leichte Sprache Rulez — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
#
# None of these keys are required for /analyse — the rule pipeline works
# without any LLM provider. They are only consulted by the /generate
# endpoint, which transforms text into Leichte Sprache via an LLM. Set at
# least one (or enable the `ollama` compose profile) if you want /generate
# to work.

# --- LLM provider keys for /generate (set at least one) ---------------------

# OpenAI — default provider for /generate (api_main.py)
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Google Gemini — the API accepts either GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Local LLM via Ollama (alternative to cloud providers) -----------------

# Ollama host for local LLM inference. Default points at the host machine for
# bare-metal/Compose-without-profile runs. When `docker compose --profile
# ollama up` is used, compose.yaml overrides this to the in-network service
# at http://ollama:11434 — leave the value here as the bare-metal fallback.
OLLAMA_HOST=http://localhost:11434

# Default Ollama model that the `ollama-pull` one-shot warmer pulls on first
# `docker compose --profile ollama up`. Override to use a different model.
OLLAMA_DEFAULT_MODEL=mistral-nemo:12b

# --- Reverse proxy / TLS termination (optional, `--profile traefik`) -------

# Public FQDN whose A/AAAA record points at this host. Required for valid
# Let's Encrypt certs. For local experimentation leave the default — no
# real cert will be issued but the proxy still routes.
TRAEFIK_DOMAIN=api.localhost

# Contact email registered with Let's Encrypt for expiry notifications.
# Required by the ACME protocol. Use a real address in production.
TRAEFIK_ACME_EMAIL=admin@example.com
